@using Microsoft.Extensions.Localization
@using CvManager
@using CvManager.Models
@model CvManager.Models.ViewModels.PositionBasicsViewModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["New position"].Value;
}

<h1 class="h4 mb-1">@L["New position"]</h1>
<p class="text-body-secondary small">
    @L["Nothing is saved until these fields are filled in, so a half-finished position never appears in the list."]
</p>

<form asp-action="Create" method="post" class="row g-3" style="max-width:720px">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

    <div class="col-12">
        <label asp-for="Title" class="form-label">
            @L["Title"] <span class="badge text-bg-danger-subtle text-danger-emphasis">@L["required"]</span>
        </label>
        <input asp-for="Title" class="form-control" placeholder="Junior Data Engineer" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Company" class="form-label">
            @L["Company"] <span class="badge text-bg-danger-subtle text-danger-emphasis">@L["required"]</span>
        </label>
        <input asp-for="Company" class="form-control" placeholder="Acme Corp." />
        <span asp-validation-for="Company" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Level" class="form-label">
            @L["Level"] <span class="badge text-bg-danger-subtle text-danger-emphasis">@L["required"]</span>
        </label>
        <select asp-for="Level" class="form-select">
            <option value="">@L["— choose —"]</option>
            @foreach (var level in Enum.GetValues<PositionLevel>())
            {
                <option value="@((int)level)" selected="@(Model.Level == level)">@level</option>
            }
        </select>
        <span asp-validation-for="Level" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="ShortDescription" class="form-label">
            @L["Short description"] <span class="badge text-bg-danger-subtle text-danger-emphasis">@L["required"]</span>
        </label>
        <textarea asp-for="ShortDescription" class="form-control" rows="3"></textarea>
        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="MaxProjects" class="form-label">@L["Max projects in CV"]</label>
        <input asp-for="MaxProjects" type="number" min="1" max="20" class="form-control" />
        <span asp-validation-for="MaxProjects" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="IsPublic" class="form-check-input" />
            <label asp-for="IsPublic" class="form-check-label">@L["Public"]</label>
        </div>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@L["Create"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
    </div>
</form>

@section Scripts {
    @* Client-side validation mirrors the data annotations; the server checks
       them again regardless. *@
    <partial name="_ValidationScriptsPartial" />
}
